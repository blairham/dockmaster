{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod tidy)",
      "Bash(go tool gofumpt:*)",
      "Bash(gofmt:*)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make vet)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker context ls:*)",
      "Bash(docker context inspect:*)",
      "Bash(docker version:*)",
      "Bash(docker info:*)",
      "Bash(pre-commit run:*)"
    ]
  }
}
